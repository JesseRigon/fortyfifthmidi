<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE CARLA-PROJECT>
<!--
  FortyFifthMidi test rig.

  A keyboard, the plugin, and a synth - the shortest chain that lets a chord be
  heard without opening a DAW:

      V49  ->  FortyFifthMidi  ->  Helm  ->  speakers
               (MIDI in/out)       (synth)

  FortyFifthMidi emits MIDI only, so something has to make the sound. Helm is
  the synth here because it was already installed; any VST2 or VST3 synth can
  replace it by swapping the second plugin.

  Open with:  bash dev/carla.sh

  THIS FILE WAS SAVED BY CARLA, and then had these comments put back. Hand-
  writing it did not work: <ProcessMode> inside <EngineSettings> is ignored and
  Carla strips it on save, so Rack mode comes from Carla's own settings
  (Settings > Engine > Process mode, stored per user in the registry on
  Windows) and not from here.

  The part that DOES belong here is
 <!--
   The three cables that connect the rack to the world. Carla makes none of
   these itself - it only discovers devices and opens one when connected.
 -->
 <ExternalPatchbay> at the bottom. Rack mode
  chains the plugins to each other, but it connects the rack to nothing - not
  the keyboard, not the speakers. Those three cables are the connection to the
  outside world, and without them the rack runs in silence with every level
  meter moving.

  The audio port names are plain "Left" and "Right" rather than the sound
  card's own name: the device itself is chosen in engine settings, so the ports
  are generic. Which is why this could have been written by hand all along.
-->
<CARLA-PROJECT VERSION='2.5'>
 <EngineSettings>
  <ForceStereo>false</ForceStereo>
  <PreferPluginBridges>false</PreferPluginBridges>
  <PreferUiBridges>true</PreferUiBridges>
  <UIsAlwaysOnTop>false</UIsAlwaysOnTop>
  <MaxParameters>200</MaxParameters>
  <UIBridgesTimeout>4000</UIBridgesTimeout>
 </EngineSettings>

 <Transport>
  <BeatsPerMinute>120</BeatsPerMinute>
 </Transport>


 <!--
   The plugin under test. Carla wants the binary INSIDE the .vst3 bundle, not
   the bundle directory - pointing at the directory fails discovery with an
   assertion about the file type.
 -->
 <Plugin>
  <Info>
   <Type>VST3</Type>
   <Name>FortyFifthMidi</Name>
   <Binary>J:\My Drive\Life\5 Media\Music\VSTs\fortyfifthmidi\FortyFifthMidi.vst3\Contents\x86_64-win\FortyFifthMidi.vst3</Binary>
   <Label>FortyFifthMidi</Label>
  </Info>

  <Data>
   <Active>Yes</Active>
   <ControlChannel>N</ControlChannel>
   <Options>0x1</Options>
  </Data>
 </Plugin>


 <!--
   The synth. Second in the rack, so it receives the plugin's MIDI output.
   Its saved parameters are deliberately not kept here: they are one patch at
   one moment, they churn on every save, and the wiring is the point.
 -->
 <Plugin>
  <Info>
   <Type>VST2</Type>
   <Name>Helm</Name>
   <Binary>J:\My Drive\Life\5 Media\Music\VSTs\Helm\helm64.dll</Binary>
   <UniqueID>1214606445</UniqueID>
  </Info>

  <Data>
   <Active>Yes</Active>
   <ControlChannel>N</ControlChannel>
   <Options>0x1</Options>
  </Data>
 </Plugin>


 <!--
   The three cables that connect the rack to the world. Carla makes none of
   these itself - it only discovers devices and opens one when connected.
 -->
 <ExternalPatchbay>
  <Connection>
   <Source>MidiIn:V49</Source>
   <Target>Carla:MidiIn</Target>
  </Connection>
  <Connection>
   <Source>Carla:AudioOut1</Source>
   <Target>AudioOut:Left</Target>
  </Connection>
  <Connection>
   <Source>Carla:AudioOut2</Source>
   <Target>AudioOut:Right</Target>
  </Connection>
 </ExternalPatchbay>
</CARLA-PROJECT>
